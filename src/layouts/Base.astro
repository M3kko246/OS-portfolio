---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import type { Lang } from '@/i18n';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative URL of the 1200x630 social image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** Structured data, serialized as JSON-LD. */
  jsonLd?: object;
  noindex?: boolean;
  bodyClass?: string;
  lang?: Lang;
  /** The same page in each language: hreflang links and og:locale alternates. */
  alternates?: Record<Lang, string>;
}

const {
  title,
  description,
  image = '/og/home.png',
  imageAlt = title,
  type = 'website',
  jsonLd,
  noindex = false,
  bodyClass,
  lang = 'it',
  alternates,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// With build.format 'file' the build sees `/classica.html`: the canonical URL is the clean
// address that the host serves without redirects, the same one hreflang and the sitemap use.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/') || '/';
const canonical = new URL(alternates ? alternates[lang] : cleanPath, site).href;
const imageUrl = new URL(image, site).href;
const locale = { it: 'it_IT', en: 'en_US' } as const;
const other: Lang = lang === 'it' ? 'en' : 'it';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="it" href={new URL(alternates.it, site).href} />
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.it, site).href} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2b2d42" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale[lang]} />
    {alternates && <meta property="og:locale:alternate" content={locale[other]} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <Font cssVariable="--ff-pixel" preload />
    <Font cssVariable="--ff-read" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
