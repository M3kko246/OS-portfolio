---
// Static boot screen: the LCP element, what crawlers and no-JS visitors see, and the surface the
// OS takes over from in T2. Name, role, CV and contact are real HTML from the first frame.
import BrandMark from '@/components/BrandMark.astro';
import { profile } from '@/data/profile';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { getProjects, pageTitle, personJsonLd } from '@/lib/content';
import { photoCount } from '@/lib/photos';

const projects = await getProjects();
const site = Astro.site ?? new URL(Astro.url.origin);
---

<Base
  title={pageTitle()}
  description={profile.bioShort}
  type="profile"
  jsonLd={personJsonLd(site)}
  bodyClass="boot-body theme-dark"
>
  <a class="boot-classic font-pixel text-ui" href="/classica">
    {t('nav.goClassic')}
  </a>
  <main class="boot">
    <div class="boot-id">
      <BrandMark scale={4} />
      <div class="flex flex-col gap-4">
        <h1 class="font-pixel text-ui-3">{profile.name}</h1>
        <p class="font-pixel text-ui-2">{profile.role}</p>
      </div>
    </div>
    <ul class="boot-log font-pixel text-ui" role="list">
      <li>{t('boot.projectsFound', { count: projects.length })}</li>
      <li>{t('boot.photosFound', { count: photoCount })}</li>
    </ul>
    <p class="flex flex-wrap gap-8">
      <a class="px-btn px-btn-primary" href={profile.cv.it} download>
        {t('action.downloadCv')}
      </a>
      <a class="px-btn" href={`mailto:${profile.email}`}>
        {t('action.contactMe')}
      </a>
    </p>
    <noscript>
      <p class="text-read max-w-[68ch]">{t('boot.noscript')}</p>
    </noscript>
  </main>
</Base>

<style>
  /* The boot screen is ink in both themes: `.theme-dark` pins the dark tokens. */
  :global(.boot-body) {
    background: var(--c-ink);
    color: var(--text);
  }
  .boot {
    display: flex;
    min-block-size: 100dvh;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 24);
    padding: calc(var(--u) * 24) max(calc(var(--u) * 16), env(safe-area-inset-left))
      calc(var(--u) * 48);
    margin-inline: auto;
    max-inline-size: 72rem;
  }
  .boot-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--u) * 16);
  }
  .boot-log {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 2);
    color: var(--c-paper);
  }
  .boot-log li::before {
    content: '> ';
    color: var(--c-sun);
  }
  .boot-classic {
    position: fixed;
    inset-block-end: max(calc(var(--u) * 16), env(safe-area-inset-bottom));
    inset-inline-start: max(calc(var(--u) * 16), env(safe-area-inset-left));
    color: var(--c-paper);
    text-decoration: underline;
    text-underline-offset: calc(var(--u) * 2);
  }
</style>
