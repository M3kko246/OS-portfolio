---
// The system. The static boot screen below is the LCP element and what crawlers and no-JS
// visitors see (name, role, CV, contact, classic version); the OS takes over from it.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import wallpapers from '@/assets/wallpapers/wallpapers.json';
import BrandMark from '@/components/BrandMark.astro';
import { profile } from '@/data/profile';
import { layoutKey } from '@/game/logic/layout';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import {
  getExperience,
  getProjects,
  layoutInput,
  pageTitle,
  personJsonLd,
  testimonials,
} from '@/lib/content';
import { albums, photoCount } from '@/lib/photos';
import OS from '@/os/OS';
import type { OsIndex } from '@/os/types';

const projects = await getProjects();
const experience = await getExperience();

// The wallpapers are rendered from the archipelago: they must show the same islands as the game.
if (layoutKey(projects.map(layoutInput)) !== wallpapers.key) {
  const message = 'The desktop wallpapers do not match the projects: run `pnpm wallpapers`.';
  if (import.meta.env.PROD) throw new Error(message);
  console.warn(message);
}
const site = Astro.site ?? new URL(Astro.url.origin);

async function image(src: ImageMetadata, width: number) {
  const out = await getImage({ src, width, format: 'webp' });
  return { src: out.src, width, height: Math.round((src.height / src.width) * width) };
}

const osIndex: OsIndex = {
  profile,
  projects: await Promise.all(
    projects.map(async ({ id, data }) => ({
      slug: id,
      title: data.title,
      tagline: data.tagline,
      summary: data.summary,
      year: data.year,
      role: data.role,
      ...(data.client ? { client: data.client } : {}),
      ...(data.duration ? { duration: data.duration } : {}),
      ...(data.team ? { team: data.team } : {}),
      status: data.status,
      stack: data.stack,
      problem: data.problem,
      approach: data.approach,
      outcomes: data.outcomes.map((o) => ({
        value: o.value,
        label: o.label,
        ...(o.source ? { source: o.source } : {}),
      })),
      cover: { ...(await image(data.cover, 640)), alt: data.coverAlt },
      gallery: await Promise.all(
        data.gallery.map(async (g) => ({
          ...(await image(g.src, 960)),
          alt: g.alt,
          ...(g.caption ? { caption: g.caption } : {}),
        })),
      ),
      links: {
        ...(data.links.live ? { live: data.links.live } : {}),
        ...(data.links.repo ? { repo: data.links.repo } : {}),
      },
      demo: data.demo,
      island: {
        biome: data.island.biome,
        landmark: data.island.landmark,
        ...(data.island.seed === undefined ? {} : { seed: data.island.seed }),
      },
      order: data.order,
      featured: data.featured,
    })),
  ),
  albums: albums.map((a) => ({ id: a.id, title: a.title, count: a.photos.length })),
  experience: experience.map(({ id, data }) => ({ id, ...data })),
  testimonials,
  classicUrl: '/classica',
};
---

<Base
  title={pageTitle()}
  description={profile.bioShort}
  type="profile"
  jsonLd={personJsonLd(site)}
  bodyClass="os-body"
>
  <div id="boot" class="boot theme-dark">
    <a class="boot-classic font-pixel text-ui" href="/classica">
      {t('nav.goClassic')}
    </a>
    <main class="boot-main">
      <div class="boot-id">
        <BrandMark scale={4} />
        <div class="flex flex-col gap-4">
          <h1 class="font-pixel text-ui-3">{profile.name}</h1>
          <p class="font-pixel text-ui-2">{profile.role}</p>
        </div>
      </div>
      <ul id="boot-log" class="boot-log font-pixel text-ui" role="list">
        <li>{t('boot.projectsFound', { count: projects.length })}</li>
        <li>{t('boot.photosFound', { count: photoCount })}</li>
      </ul>
      <p class="flex flex-wrap gap-8">
        <a class="px-btn px-btn-primary" href={profile.cv.it} download>
          {t('action.downloadCv')}
        </a>
        <a class="px-btn" href={`mailto:${profile.email}`}>
          {t('action.contactMe')}
        </a>
      </p>
      <noscript>
        <p class="text-read max-w-[68ch]">{t('boot.noscript')}</p>
      </noscript>
    </main>
  </div>
  <OS client:only="react" data={osIndex} />
</Base>

<style>
  :global(.os-body) {
    overflow: hidden;
    background: var(--c-night);
  }
  /* The boot screen is ink in every theme: `.theme-dark` pins the dark tokens. */
  .boot {
    position: fixed;
    inset: 0;
    z-index: var(--z-boot);
    overflow: auto;
    background: var(--c-ink);
    color: var(--text);
  }
  .boot-main {
    display: flex;
    min-block-size: 100dvh;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 24);
    padding: calc(var(--u) * 24) max(calc(var(--u) * 16), env(safe-area-inset-left))
      calc(var(--u) * 48);
    margin-inline: auto;
    max-inline-size: 72rem;
  }
  .boot-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--u) * 16);
  }
  .boot-log {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 2);
  }
  .boot-log :global(li)::before {
    content: '> ';
    color: var(--c-sun);
  }
  .boot-classic {
    position: fixed;
    inset-block-end: max(calc(var(--u) * 16), env(safe-area-inset-bottom));
    inset-inline-start: max(calc(var(--u) * 16), env(safe-area-inset-left));
    color: var(--c-paper);
    text-decoration: underline;
    text-underline-offset: calc(var(--u) * 2);
  }
</style>
