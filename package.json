{
  "name": "portfolio-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/check-photos.ts && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "budgets": "tsx scripts/check-budgets.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "fonts": "tsx scripts/subset-fonts.ts",
    "sprites": "tsx scripts/build-sprites.ts",
    "wallpapers": "tsx scripts/render-wallpapers.ts",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "astro": "7.3.5",
    "pixelarticons": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "three": "0.186.0",
    "zustand": "5.0.15",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "harfbuzzjs": "1.6.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "satori": "0.33.5",
    "schema-dts": "2.0.0",
    "sharp": "0.35.4",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
