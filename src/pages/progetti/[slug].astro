---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BrandMark from '@/components/BrandMark.astro';
import { profile } from '@/data/profile';
import { t, type MessageKey } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { getProjects, pageTitle, type Project } from '@/lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const { data } = project;
const { Content } = await render(project);
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(`/progetti/${project.id}`, site).href;
const ogImage = `/og/progetti/${project.id}.png`;

const facts = [
  ['project.year', String(data.year)],
  ['project.role', data.role],
  ['project.client', data.client],
  ['project.duration', data.duration],
  ['project.team', data.team],
  ['project.status', t(`status.${data.status}`)],
].filter((fact): fact is [MessageKey, string] => fact[1] !== undefined);

const demoUrl = data.demo.kind === 'none' ? undefined : data.demo.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  headline: data.tagline,
  description: data.summary,
  dateCreated: String(data.year),
  url,
  image: new URL(ogImage, site).href,
  keywords: data.stack.join(', '),
  creator: { '@type': 'Person', name: profile.name, jobTitle: profile.role, url: site.href },
};
---

<Base
  title={pageTitle(data.title)}
  description={data.summary}
  type="article"
  image={ogImage}
  imageAlt={data.title}
  jsonLd={jsonLd}
>
  <a class="skip-link font-pixel text-ui" href="#contenuto">
    {t('nav.skipToContent')}
  </a>
  <header class="site-bar">
    <a class="site-bar-home font-pixel text-ui" href="/classica#progetti">
      <BrandMark scale={1} />
      {t('nav.allProjects')}
    </a>
    <a class="px-btn" href={`/?progetto=${project.id}`}>
      {t('nav.openOs', { os: profile.osName })}
    </a>
  </header>

  <main id="contenuto" class="page">
    <header class="flex flex-col gap-4">
      <h1 class="text-read-xl font-bold">{data.title}</h1>
      <p class="text-read-lg">{data.tagline}</p>
    </header>

    <Picture
      src={data.cover}
      alt={data.coverAlt}
      formats={['avif', 'webp']}
      widths={[480, 960, 1440]}
      sizes="(min-width: 72rem) 70rem, 100vw"
      loading="eager"
      fetchpriority="high"
      class="cover"
    />

    <section aria-labelledby="dati">
      <h2 id="dati" class="sr-only">
        {t('project.details')}
      </h2>
      <dl class="facts">
        {facts.map(([key, value]) => (
          <>
            <dt>{t(key)}</dt>
            <dd>{value}</dd>
          </>
        ))}
      </dl>
      <ul class="tags font-pixel text-ui mt-8" role="list" aria-label={t('project.stack')}>
        {data.stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="mt-12 flex flex-wrap gap-8">
        {demoUrl && (
          <a class="px-btn px-btn-primary" href={demoUrl} rel="noopener noreferrer">
            {t('action.tryDemo')}
          </a>
        )}
        {data.links.repo && (
          <a class="px-btn" href={data.links.repo} rel="noopener noreferrer">
            {t('action.code')}
          </a>
        )}
        {data.links.live && (
          <a class="px-btn" href={data.links.live} rel="noopener noreferrer">
            {t('action.visitSite')}
          </a>
        )}
      </p>
    </section>

    <section aria-labelledby="problema">
      <h2 id="problema">{t('project.problem')}</h2>
      <p>{data.problem}</p>
    </section>

    <section aria-labelledby="approccio">
      <h2 id="approccio">{t('project.approach')}</h2>
      <p>{data.approach}</p>
    </section>

    {data.outcomes.length > 0 && (
      <section aria-labelledby="risultati">
        <h2 id="risultati">{t('project.outcomes')}</h2>
        <ul class="outcomes">
          {data.outcomes.map((o) => (
            <li>
              <strong>{o.value}</strong> {o.label}
              {o.source && <span> ({t('project.source', { source: o.source })})</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="caso-studio" class="prose">
      <h2 id="caso-studio">{t('project.caseStudy')}</h2>
      <Content />
    </section>

    {data.gallery.length > 0 && (
      <section aria-labelledby="galleria">
        <h2 id="galleria">{t('project.gallery')}</h2>
        <ul class="gallery" role="list">
          {data.gallery.map((item) => (
            <li>
              <figure>
                <Picture
                  src={item.src}
                  alt={item.alt}
                  formats={['avif', 'webp']}
                  widths={[480, 960]}
                  sizes="(min-width: 48rem) 22rem, 100vw"
                />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <footer class="site-footer font-pixel text-ui">
    <a href="/classica">{t('nav.classic')}</a>
    <a href={`/?progetto=${project.id}`}>{t('nav.openOs', { os: profile.osName })}</a>
  </footer>
</Base>
