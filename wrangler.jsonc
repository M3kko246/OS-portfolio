{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-os",
  "compatibility_date": "2026-09-01",
  // Secrets (RESEND_API_KEY, CONTACT_TO, CONTACT_FROM) are set with `wrangler secret put`,
  // never here. For local runs put them in .dev.vars (git-ignored).
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
