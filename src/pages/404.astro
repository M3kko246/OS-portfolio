---
import Icon from '@/components/Icon.astro';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { localProfile } from '@/lib/localize';
import { paths } from '@/lib/paths';

// One page answers every missing address, in both languages.
const profile = localProfile('it');
---

<Base title={`${t('notFound.title')}, ${profile.osName}`} description={t('notFound.body')} noindex>
  <main class="grid min-h-dvh place-items-center p-16">
    <section class="px-shell error-window" aria-labelledby="errore">
      <p class="bg-title-bg px-6 py-2 font-pixel text-ui text-title-fg">{t('notFound.window')}</p>
      <div class="flex items-start gap-12 p-12">
        <Icon name="warning-diamond" class="icon-2" />
        <div class="flex flex-col gap-8">
          <h1 id="errore" class="font-pixel text-ui-2">
            {t('notFound.title')}
          </h1>
          <p class="text-read max-w-[46ch]">{t('notFound.body')}</p>
          <p class="text-read max-w-[46ch]" lang="en">
            {t('notFound.title', {}, 'en')}. {t('notFound.body', {}, 'en')}
          </p>
        </div>
      </div>
      <p class="flex flex-wrap justify-end gap-8 px-12 pb-12">
        <a class="px-btn px-btn-primary" href={paths.home('it')}>
          {t('action.backToDesktop')}
        </a>
        <a class="px-btn" href={paths.classic('it')}>
          {t('nav.classic')}
        </a>
        <a class="px-btn" href={paths.home('en')} lang="en">
          {t('action.backToDesktop', {}, 'en')}
        </a>
      </p>
    </section>
  </main>
</Base>

<style>
  .error-window {
    max-inline-size: 40rem;
    padding: calc(var(--u) * 3);
  }
</style>
