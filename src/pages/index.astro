---
// Temporary T0 page: palette and semantic tokens in both themes. Replaced by the desktop in T2.
import Base from '@/layouts/Base.astro';
import { palette, paletteNames } from '@/design/palette';
---

<Base title="Token di sistema" description="Palette e token dell'interfaccia nei due temi.">
  <main class="mx-auto flex max-w-[68rem] flex-col gap-24 p-16">
    <header class="flex flex-col gap-8">
      <h1 class="font-pixel text-ui-3">Token di sistema</h1>
      <p class="text-read max-w-[68ch]">
        Pagina provvisoria della tappa T0: mostra la palette e i token nei due temi. Nella tappa T2
        lascia il posto al desktop.
      </p>
      <fieldset class="flex flex-wrap items-center gap-12 font-pixel text-ui">
        <legend class="mb-4">Tema</legend>
        <label class="flex items-center gap-4">
          <input type="radio" name="theme" value="auto" checked /> Auto
        </label>
        <label class="flex items-center gap-4">
          <input type="radio" name="theme" value="light" /> Giorno
        </label>
        <label class="flex items-center gap-4">
          <input type="radio" name="theme" value="dark" /> Notte
        </label>
      </fieldset>
    </header>

    <section aria-labelledby="palette-title" class="flex flex-col gap-8">
      <h2 id="palette-title" class="font-pixel text-ui-2">
        Palette
      </h2>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-8" role="list">
        {paletteNames.map((name) => (
          <li class="flex items-center gap-8 font-pixel text-ui">
            <span class="swatch" data-color={name} aria-hidden="true" />
            <span>
              {name}
              <br />
              <span class="text-text-muted">{palette[name]}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="surfaces-title" class="flex flex-col gap-8">
      <h2 id="surfaces-title" class="font-pixel text-ui-2">
        Superfici
      </h2>
      <div class="flex flex-wrap items-start gap-24">
        <div class="px-shell flex w-[22rem] flex-col gap-2 p-3">
          <p class="bg-title-bg px-4 py-2 font-pixel text-ui text-title-fg">Finestra attiva</p>
          <div class="px-well flex flex-col gap-6 p-8">
            <p class="text-read">Testo principale nel pozzo.</p>
            <p class="text-read text-text-muted">Testo secondario nel pozzo.</p>
            <p class="text-read">
              <a class="text-link underline" href="/">
                Collegamento
              </a>
            </p>
          </div>
          <div class="flex flex-wrap gap-6 p-4">
            <button class="px-btn px-btn-primary" type="button">
              Primario
            </button>
            <button class="px-btn" type="button">
              Secondario
            </button>
            <button class="px-btn" type="button" disabled>
              Disabilitato
            </button>
          </div>
          <p class="px-4 font-pixel text-ui text-text-muted-on-face">
            Testo secondario sulla cornice
          </p>
        </div>
        <div class="px-shell flex w-[22rem] flex-col gap-2 p-3">
          <p class="bg-title-idle-bg px-4 py-2 font-pixel text-ui text-title-idle-fg">
            Finestra inattiva
          </p>
          <div class="px-well flex flex-col gap-6 p-8">
            <p class="text-read">
              <span class="px-error font-pixel text-ui">Esempio di messaggio di errore</span>
            </p>
            <p class="bg-accent px-4 font-pixel text-ui text-on-accent">Elemento selezionato</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const root = document.documentElement;
  for (const input of document.querySelectorAll<HTMLInputElement>('input[name="theme"]')) {
    input.addEventListener('change', () => {
      if (input.value === 'auto') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', input.value);
    });
  }
</script>

<style>
  /* Swatches are previews: the only place raw world colors may appear in the UI. */
  .swatch {
    inline-size: calc(var(--u) * 24);
    block-size: calc(var(--u) * 24);
    flex: none;
    box-shadow: inset 0 0 0 var(--u) var(--edge);
  }
  .swatch[data-color='ink'] {
    background: var(--c-ink);
  }
  .swatch[data-color='night'] {
    background: var(--c-night);
  }
  .swatch[data-color='slate'] {
    background: var(--c-slate);
  }
  .swatch[data-color='fog'] {
    background: var(--c-fog);
  }
  .swatch[data-color='chalk'] {
    background: var(--c-chalk);
  }
  .swatch[data-color='paper'] {
    background: var(--c-paper);
  }
  .swatch[data-color='abyss'] {
    background: var(--c-abyss);
  }
  .swatch[data-color='sea'] {
    background: var(--c-sea);
  }
  .swatch[data-color='lagoon'] {
    background: var(--c-lagoon);
  }
  .swatch[data-color='foam'] {
    background: var(--c-foam);
  }
  .swatch[data-color='olive'] {
    background: var(--c-olive);
  }
  .swatch[data-color='meadow'] {
    background: var(--c-meadow);
  }
  .swatch[data-color='sand'] {
    background: var(--c-sand);
  }
  .swatch[data-color='sun'] {
    background: var(--c-sun);
  }
  .swatch[data-color='brick'] {
    background: var(--c-brick);
  }
  .swatch[data-color='plum'] {
    background: var(--c-plum);
  }
</style>
